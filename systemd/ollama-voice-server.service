[Unit]
Description=Ollama Voice Input - Web 服务器
After=network.target ollama.service
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
WorkingDirectory=/home/spp/桌面/ollama-voice-input
Environment=LD_LIBRARY_PATH=/home/spp/桌面/ollama-voice-input/.venv/lib/python3.12/site-packages/nvidia/cublas/lib:/home/spp/桌面/ollama-voice-input/.venv/lib/python3.12/site-packages/nvidia/cudnn/lib:/home/spp/桌面/ollama-voice-input/.venv/lib/python3.12/site-packages/nvidia/cuda_nvrtc/lib
ExecStartPre=-/usr/bin/fuser -k -TERM 17945/tcp
ExecStart=/home/spp/桌面/ollama-voice-input/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 17945
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
